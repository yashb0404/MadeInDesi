# Razorpay. Get these from dashboard.razorpay.com.
#
# Copy this file to .env.local and fill it in. Start in TEST MODE — the test
# keys work immediately, with no KYC, and no real money can move through them.
# Test keys begin rzp_test_, live keys begin rzp_live_.
#
# Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Settings > Webhooks > Add New Webhook. You choose this secret yourself and
# paste the same string in both places. Subscribe to exactly two events:
#   payment.captured
#   payment.failed
# Webhook URL: https://<your-domain>/api/razorpay/webhook
# Razorpay cannot reach localhost — use an ngrok URL or a preview deploy to
# test webhooks locally.
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# The live origin, no trailing slash. Sitemap URLs, canonical tags, social-card
# image URLs and the structured data all resolve against this — leave it unset
# in production and Google is handed localhost links.
NEXT_PUBLIC_SITE_URL=https://madeindesi.com
